[
  {
    "id": "lyric-1",
    "title": "稻香",
    "author": "周杰伦",
    "paragraphs": [
      ["对这个世界如果你有太多的抱怨", "跌倒了就不敢继续往前走"],
      ["为什么人要这么的脆弱堕落", "请你打开电视看看"]
    ]
  },
  {
    "id": "lyric-2",
    "title": "晴天",
    "author": "周杰伦",
    "paragraphs": [
      ["故事的小黄花", "从出生那年就飘着"],
      ["童年的荡秋千", "随记忆一直晃到现在"]
    ]
  },
  {
    "id": "lyric-3",
    "title": "夜空中最亮的星",
    "author": "逃跑计划",
    "paragraphs": [
      ["夜空中最亮的星", "能否听清"],
      ["那仰望的人", "心底的孤独和叹息"]
    ]
  },
  {
    "id": "lyric-4",
    "title": "修炼爱情",
    "author": "林俊杰",
    "paragraphs": [
      ["凭什么要失望", "藏眼泪到心脏"],
      ["往事不会说谎", "别跟它为难"]
    ]
  },
  {
    "id": "lyric-5",
    "title": "泡沫",
    "author": "邓紫棋",
    "paragraphs": [
      ["阳光下的泡沫", "是彩色的"],
      ["就像被骗的我", "是幸福的"]
    ]
  },
  {
    "id": "lyric-6",
    "title": "知足",
    "author": "五月天",
    "paragraphs": [
      ["怎么去拥有一道彩虹", "怎么去拥抱一夏天的风"],
      ["天上的星星笑地上的人", "总是不能懂不能觉得足够"]
    ]
  }
]
